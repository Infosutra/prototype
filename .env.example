# API server
PORT=8080
DATABASE_PATH=./data/infosutra.sqlite

# Generate with: openssl rand -base64 32
# Keep this key with database backups; changing it makes saved Kobo tokens unreadable.
KOBO_CREDENTIALS_ENCRYPTION_KEY=

# Frontend development server (set separately when running Vite)
BASE_PATH=/
API_URL=http://127.0.0.1:8080
